From e97514c94ce74a0860da240b393bac7519cad31f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 18:27:38 +0900
Subject: [PATCH] media: ipu-bridge: Request non-continuous clock for ov5693 on
 IPU6

The IPU6 CSI-2 receiver of the Surface Pro 7+/8 (Tiger Lake), Pro 9
(Alder Lake-P) and Go 4 (Alder Lake-N) does not lock onto the free
running clock lane the ov5693 uses by default: the front camera powers
up and claims to stream, but capture times out.

Add a "clock-noncontinuous" property to the sensor endpoint for the
ov5693 (INT33BE and OVTI5693) when it is connected to one of these
IPUs, so the sensor driver gates its clock lane. The IPU3 CIO2 and the
other sensors are left alone.

The endpoint properties are now filled with a running index, so that
optional entries do not leave a hole that would terminate the list
early (e.g. a sensor without link frequencies). The property name is
stored in struct ipu_property_names like the others, so that it stays
valid as long as the software nodes.

Link: https://github.com/linux-surface/linux-surface/issues/1893
Link: https://lkml.iu.edu/2607.2/08163.html
Patchset: cameras
---
 drivers/media/pci/intel/ipu-bridge.c | 54 +++++++++++++++++++++++++---
 include/media/ipu-bridge.h           |  3 +-
 2 files changed, 52 insertions(+), 5 deletions(-)

diff --git a/drivers/media/pci/intel/ipu-bridge.c b/drivers/media/pci/intel/ipu-bridge.c
index 1aa595cbb..e930f39e6 100644
--- a/drivers/media/pci/intel/ipu-bridge.c
+++ b/drivers/media/pci/intel/ipu-bridge.c
@@ -8,6 +8,7 @@
 #include <linux/dmi.h>
 #include <linux/i2c.h>
 #include <linux/mei_cl_bus.h>
+#include <linux/pci.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
 #include <linux/property.h>
@@ -163,6 +164,30 @@ static const struct ipu_property_names prop_names = {
 	.data_lanes = "data-lanes",
 	.remote_endpoint = "remote-endpoint",
 	.link_frequencies = "link-frequencies",
+	.clock_noncontinuous = "clock-noncontinuous",
+};
+
+/*
+ * Sensors that must gate their MIPI clock lane (non-continuous clock mode)
+ * when they are connected to one of the IPUs listed below. The IPU6 CSI-2
+ * receiver of these platforms does not lock onto the free running clock lane
+ * that the sensor drivers use by default, and capture times out.
+ */
+static const char * const ipu_noncontinuous_clock_sensors[] = {
+	/* Omnivision OV5693 (Surface Pro 7+, Pro 8, Go 4) */
+	"INT33BE",
+	/* Omnivision OV5693 (Surface Pro 9) */
+	"OVTI5693",
+};
+
+static const struct pci_device_id ipu_noncontinuous_clock_ipus[] = {
+	/* IPU6, Tiger Lake (Surface Pro 7+, Pro 8) */
+	{ PCI_VDEVICE(INTEL, 0x9a19) },
+	/* IPU6EP, Alder Lake-P (Surface Pro 9) */
+	{ PCI_VDEVICE(INTEL, 0x465d) },
+	/* IPU6EP, Alder Lake-N (Surface Go 4) */
+	{ PCI_VDEVICE(INTEL, 0x462e) },
+	{ }
 };
 
 static const char * const ipu_vcm_types[] = {
@@ -425,6 +450,19 @@ int ipu_bridge_parse_ssdb(struct acpi_device *adev, struct ipu_sensor *sensor)
 }
 EXPORT_SYMBOL_NS_GPL(ipu_bridge_parse_ssdb, "INTEL_IPU_BRIDGE");
 
+static bool ipu_bridge_needs_noncontinuous_clock(
+	struct ipu_bridge *bridge,
+	const struct ipu_sensor_config *cfg)
+{
+	if (!dev_is_pci(bridge->dev) ||
+	    !pci_match_id(ipu_noncontinuous_clock_ipus, to_pci_dev(bridge->dev)))
+		return false;
+
+	return match_string(ipu_noncontinuous_clock_sensors,
+			    ARRAY_SIZE(ipu_noncontinuous_clock_sensors),
+			    cfg->hid) >= 0;
+}
+
 static void ipu_bridge_create_fwnode_properties(
 	struct ipu_sensor *sensor,
 	struct ipu_bridge *bridge,
@@ -432,6 +470,7 @@ static void ipu_bridge_create_fwnode_properties(
 {
 	struct ipu_property_names *names = &sensor->prop_names;
 	struct software_node *nodes = sensor->swnodes;
+	unsigned int ep = 0;
 
 	sensor->prop_names = prop_names;
 
@@ -489,22 +528,29 @@ static void ipu_bridge_create_fwnode_properties(
 			PROPERTY_ENTRY_REF_ARRAY("lens-focus", sensor->vcm_ref);
 	}
 
-	sensor->ep_properties[0] = PROPERTY_ENTRY_U32(
+	sensor->ep_properties[ep++] = PROPERTY_ENTRY_U32(
 					sensor->prop_names.bus_type,
 					V4L2_FWNODE_BUS_TYPE_CSI2_DPHY);
-	sensor->ep_properties[1] = PROPERTY_ENTRY_U32_ARRAY_LEN(
+	sensor->ep_properties[ep++] = PROPERTY_ENTRY_U32_ARRAY_LEN(
 					sensor->prop_names.data_lanes,
 					bridge->data_lanes, sensor->lanes);
-	sensor->ep_properties[2] = PROPERTY_ENTRY_REF_ARRAY(
+	sensor->ep_properties[ep++] = PROPERTY_ENTRY_REF_ARRAY(
 					sensor->prop_names.remote_endpoint,
 					sensor->local_ref);
 
 	if (cfg->nr_link_freqs > 0)
-		sensor->ep_properties[3] = PROPERTY_ENTRY_U64_ARRAY_LEN(
+		sensor->ep_properties[ep++] = PROPERTY_ENTRY_U64_ARRAY_LEN(
 			sensor->prop_names.link_frequencies,
 			cfg->link_freqs,
 			cfg->nr_link_freqs);
 
+	if (ipu_bridge_needs_noncontinuous_clock(bridge, cfg)) {
+		dev_dbg(bridge->dev, "%s: requesting non-continuous MIPI clock\n",
+			cfg->hid);
+		sensor->ep_properties[ep++] = PROPERTY_ENTRY_BOOL(
+			sensor->prop_names.clock_noncontinuous);
+	}
+
 	sensor->ipu_properties[0] = PROPERTY_ENTRY_U32_ARRAY_LEN(
 					sensor->prop_names.data_lanes,
 					bridge->data_lanes, sensor->lanes);
diff --git a/include/media/ipu-bridge.h b/include/media/ipu-bridge.h
index 16fac7654..411c84eb2 100644
--- a/include/media/ipu-bridge.h
+++ b/include/media/ipu-bridge.h
@@ -102,6 +102,7 @@ struct ipu_property_names {
 	char data_lanes[11];
 	char remote_endpoint[16];
 	char link_frequencies[17];
+	char clock_noncontinuous[20];
 };
 
 struct ipu_node_names {
@@ -141,7 +142,7 @@ struct ipu_sensor {
 	const char *vcm_type;
 
 	struct ipu_property_names prop_names;
-	struct property_entry ep_properties[5];
+	struct property_entry ep_properties[6];
 	struct property_entry dev_properties[5];
 	struct property_entry ipu_properties[3];
 	struct property_entry ivsc_properties[1];
-- 
