From 4c12891ba80cf41734909e4ba2f402464139139c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 18:28:37 +0900
Subject: [PATCH] media: i2c: ov13858: Wait for the IPU bridge and tidy up
 power handling

The Surface Pro 8 uses the same rear camera module and the same INT3472
power layout as the Surface Pro 9 (avdd on GPIO type 0x0b, a second
rail on GPIO type 0x08, reset, privacy LED, clock enabled through the
_DSM), so the power handling added for the Pro 9 is what makes the
rear camera of the Pro 8 work as well. Clean it up a bit:

 - Defer probing until the fwnode graph exists. On these devices it is
   built by the IPU bridge when the IPU driver probes, together with the
   rotation, orientation and clock-frequency properties. Without this,
   the sensor may register before the bridge has run and then lacks the
   orientation/rotation controls that libcamera uses to tell the front
   and rear cameras apart. Other sensor drivers used with the bridge
   (ov5693, ov8865, ov2740, ...) do the same.

 - Enable the clock obtained by devm_v4l2_sensor_clk_get() instead of
   requesting the same clock a second time as "xvclk".

 - Turn the messages printed on every runtime suspend/resume into debug
   messages and drop the chip ID debug output.

 - Include the GPIO and regulator consumer headers explicitly.

Link: https://github.com/linux-surface/linux-surface/issues/1893
Patchset: cameras
---
 drivers/media/i2c/ov13858.c | 76 +++++++++++++++++--------------------
 1 file changed, 35 insertions(+), 41 deletions(-)

diff --git a/drivers/media/i2c/ov13858.c b/drivers/media/i2c/ov13858.c
index 015493a16..91b1ce97b 100644
--- a/drivers/media/i2c/ov13858.c
+++ b/drivers/media/i2c/ov13858.c
@@ -4,9 +4,11 @@
 #include <linux/acpi.h>
 #include <linux/delay.h>
 #include <linux/clk.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
 #include <media/v4l2-event.h>
@@ -120,10 +122,14 @@ struct ov13858_mode {
 	struct ov13858_reg_list reg_list;
 };
 
-// Or use standard names that might be more correct:
+/*
+ * Supplies provided by the INT3472 discrete power controller on the Surface
+ * Pro 8/9: "avdd" (GPIO type 0x0b) and a second rail (GPIO type 0x08).
+ * Systems that power the sensor through ACPI get dummy regulators.
+ */
 static const char * const ov13858_supply_names[] = {
-	"avdd",    // Analog voltage
-	"pwr1",    // Digital core voltage
+	"avdd",
+	"pwr1",
 };
 
 #define OV13858_NUM_SUPPLIES ARRAY_SIZE(ov13858_supply_names)
@@ -1057,7 +1063,6 @@ struct ov13858 {
 
 	struct regulator_bulk_data supplies[OV13858_NUM_SUPPLIES];
 	struct gpio_desc *reset;
-	struct clk *xvclk;
 
 	/* Mutex for serialized access */
 	struct mutex mutex;
@@ -1065,7 +1070,6 @@ struct ov13858 {
 
 #define to_ov13858(_sd)	container_of(_sd, struct ov13858, sd)
 
-
 static int ov13858_get_regulators(struct ov13858 *ov13858)
 {
 	unsigned int i;
@@ -1081,57 +1085,44 @@ static int ov13858_sensor_powerup(struct ov13858 *ov13858)
 {
 	int ret;
 
-	dev_info(ov13858->dev, "Powering up sensor\n");
+	dev_dbg(ov13858->dev, "powering up sensor\n");
 
-	/* Assert reset */
+	/* Keep the sensor in reset while the supplies come up */
 	gpiod_set_value_cansleep(ov13858->reset, 1);
 
-	/* Enable clock FIRST - sensor needs clock to communicate */
-	ret = clk_prepare_enable(ov13858->xvclk);
+	ret = clk_prepare_enable(ov13858->clk);
 	if (ret) {
-		dev_err(ov13858->dev, "Failed to enable clock: %d\n", ret);
+		dev_err(ov13858->dev, "failed to enable clock: %d\n", ret);
 		return ret;
 	}
-	dev_info(ov13858->dev, "Clock enabled\n");
 
-	/* Enable regulators */
 	ret = regulator_bulk_enable(OV13858_NUM_SUPPLIES, ov13858->supplies);
 	if (ret) {
-		dev_err(ov13858->dev, "Failed to enable regulators: %d\n", ret);
-		clk_disable_unprepare(ov13858->xvclk);
+		dev_err(ov13858->dev, "failed to enable regulators: %d\n", ret);
+		clk_disable_unprepare(ov13858->clk);
 		return ret;
 	}
 
-	dev_info(ov13858->dev, "Regulators enabled\n");
-
-	/* Wait for power to stabilize */
+	/* Wait for the supplies to stabilize */
 	usleep_range(5000, 10000);
 
-	/* De-assert reset */
 	gpiod_set_value_cansleep(ov13858->reset, 0);
 
-	/* Wait for sensor to boot */
+	/* Wait for the sensor to boot */
 	msleep(20);
 
-	dev_info(ov13858->dev, "Reset de-asserted, sensor should be ready\n");
-
 	return 0;
 }
 
 static void ov13858_sensor_powerdown(struct ov13858 *ov13858)
 {
-	dev_info(ov13858->dev, "Powering down sensor\n");
+	dev_dbg(ov13858->dev, "powering down sensor\n");
 
-	/* Assert reset to put sensor in reset state */
 	gpiod_set_value_cansleep(ov13858->reset, 1);
 
-	/* Disable regulators */
 	regulator_bulk_disable(OV13858_NUM_SUPPLIES, ov13858->supplies);
-	dev_info(ov13858->dev, "Regulators disabled\n");
 
-	/* Disable clock */
-	clk_disable_unprepare(ov13858->xvclk);
-	dev_info(ov13858->dev, "Clock disabled\n");
+	clk_disable_unprepare(ov13858->clk);
 }
 
 static int __maybe_unused ov13858_suspend(struct device *dev)
@@ -1621,11 +1612,8 @@ static int ov13858_identify_module(struct ov13858 *ov13858)
 	int ret;
 	u32 val;
 
-	dev_info(ov13858->dev, "Attempting to read chip ID from register 0x300a\n");
 	ret = ov13858_read_reg(ov13858, OV13858_REG_CHIP_ID,
 			       OV13858_REG_VALUE_24BIT, &val);
-	dev_info(ov13858->dev, "Chip ID read result: ret=%d, val=0x%06x (expected 0x%06x)\n",
-	         ret, val, OV13858_CHIP_ID);
 	if (ret)
 		return ret;
 
@@ -1635,7 +1623,6 @@ static int ov13858_identify_module(struct ov13858 *ov13858)
 		return -EIO;
 	}
 
-	dev_info(ov13858->dev, "Chip ID verified successfully!\n");
 	return 0;
 }
 
@@ -1784,10 +1771,23 @@ static void ov13858_free_controls(struct ov13858 *ov13858)
 
 static int ov13858_probe(struct i2c_client *client)
 {
+	struct fwnode_handle *endpoint;
 	struct ov13858 *ov13858;
 	unsigned long freq;
 	int ret;
 
+	/*
+	 * On systems shipped with Windows the fwnode graph (and the rotation
+	 * and orientation properties) is created by the IPU bridge, wait for
+	 * it so that the sensor is not registered without them.
+	 */
+	endpoint = fwnode_graph_get_next_endpoint(dev_fwnode(&client->dev),
+						  NULL);
+	if (!endpoint)
+		return dev_err_probe(&client->dev, -EPROBE_DEFER,
+				     "waiting for fwnode graph endpoint\n");
+	fwnode_handle_put(endpoint);
+
 	ov13858 = devm_kzalloc(&client->dev, sizeof(*ov13858), GFP_KERNEL);
 	if (!ov13858)
 		return -ENOMEM;
@@ -1805,19 +1805,13 @@ static int ov13858_probe(struct i2c_client *client)
 				     "external clock %lu is not supported\n",
 				     freq);
 
-	/* Get the external clock */
-	ov13858->xvclk = devm_clk_get_optional(ov13858->dev, "xvclk");
-	if (IS_ERR(ov13858->xvclk))
-		return dev_err_probe(ov13858->dev, PTR_ERR(ov13858->xvclk),
-		       "failed to get xvclk\n");
-
 	/* Initialize subdev */
 	v4l2_i2c_subdev_init(&ov13858->sd, client, &ov13858_subdev_ops);
 
 	ret = ov13858_get_regulators(ov13858);
 	if (ret)
 		return dev_err_probe(ov13858->dev, ret,
-		       "Error fetching regulators\n");
+				     "failed to get regulators\n");
 
 	ret = ov13858_get_gpios(ov13858);
 	if (ret)
@@ -1825,13 +1819,13 @@ static int ov13858_probe(struct i2c_client *client)
 
 	ret = ov13858_sensor_powerup(ov13858);
 	if (ret)
-		return ret;  // No cleanup needed yet, devm handles GPIOs/regulators
+		return ret;
 
 	/* Check module identity */
 	ret = ov13858_identify_module(ov13858);
 	if (ret) {
 		dev_err(ov13858->dev, "failed to find sensor: %d\n", ret);
-		goto error_power_off;  // Now we need to power down
+		goto error_power_off;
 	}
 
 	/* Set default mode to max resolution */
-- 
