From a6c0ab75a1462c4896d48cef3e5f3c61f595ad07 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 7 Oct 2026 18:26:25 +0900
Subject: [PATCH] media: i2c: ov5693: Gate the MIPI clock lane for
 non-continuous clock

The driver never touches MIPI_CTRL00 (0x4800), so the sensor always runs
its MIPI clock lane continuously. The IPU3 CIO2 receiver copes with
that, but the IPU6 found in the Surface Pro 8 (and the Pro 7+, Pro 9 and
Go 4) does not: the sensor reports streaming, yet the CSI-2 receiver
gets no packets, so capture times out ("stream stop time out") or, at
best, works once after a cold boot and then fails.

The Windows driver programs MIPI_CTRL00 = 0x2d on these devices, and
bit 5 (clock lane gate) alone turned out to be what the IPU6 needs.

Parse the "clock-noncontinuous" endpoint property and set the clock lane
gate bit before starting the stream when it is present. Systems that do
not ask for a non-continuous clock keep the register untouched.

Link: https://github.com/linux-surface/linux-surface/issues/1893
Link: https://github.com/linux-surface/linux-surface/pull/2171
Link: https://lkml.iu.edu/2607.2/08163.html
Patchset: cameras
---
 drivers/media/i2c/ov5693.c | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/drivers/media/i2c/ov5693.c b/drivers/media/i2c/ov5693.c
index 7aa4861f6..9e8ce683e 100644
--- a/drivers/media/i2c/ov5693.c
+++ b/drivers/media/i2c/ov5693.c
@@ -98,6 +98,10 @@
 #define OV5693_ISP_CTRL2_REG			CCI_REG8(0x5002)
 #define OV5693_ISP_SCALE_ENABLE			BIT(7)
 
+/* MIPI */
+#define OV5693_MIPI_CTRL00_REG			CCI_REG8(0x4800)
+#define OV5693_MIPI_CTRL00_CLK_LANE_GATE	BIT(5)
+
 /* Pixel Array */
 #define OV5693_NATIVE_WIDTH			2624
 #define OV5693_NATIVE_HEIGHT			1956
@@ -144,6 +148,9 @@ struct ov5693_device {
 	struct regulator_bulk_data supplies[OV5693_NUM_SUPPLIES];
 	struct clk *xvclk;
 
+	/* Gate the MIPI clock lane between packets (non-continuous clock) */
+	bool noncontinuous_clock;
+
 	struct ov5693_mode {
 		struct v4l2_rect crop;
 		struct v4l2_mbus_framefmt format;
@@ -611,6 +618,16 @@ static int ov5693_enable_streaming(struct ov5693_device *ov5693, bool enable)
 {
 	int ret = 0;
 
+	/*
+	 * The software reset in ov5693_sensor_init() puts MIPI_CTRL00 back to
+	 * its power-on default (free running clock lane), so gate the clock
+	 * lane right before starting the stream when it has been requested.
+	 */
+	if (enable && ov5693->noncontinuous_clock)
+		cci_update_bits(ov5693->regmap, OV5693_MIPI_CTRL00_REG,
+				OV5693_MIPI_CTRL00_CLK_LANE_GATE,
+				OV5693_MIPI_CTRL00_CLK_LANE_GATE, &ret);
+
 	cci_write(ov5693->regmap, OV5693_SW_STREAM_REG,
 		  enable ? OV5693_START_STREAMING : OV5693_STOP_STREAMING,
 		  &ret);
@@ -1271,6 +1288,11 @@ static int ov5693_check_hwcfg(struct ov5693_device *ov5693)
 		goto out_free_bus_cfg;
 	}
 
+	ov5693->noncontinuous_clock = bus_cfg.bus.mipi_csi2.flags &
+				      V4L2_MBUS_CSI2_NONCONTINUOUS_CLOCK;
+	if (ov5693->noncontinuous_clock)
+		dev_dbg(ov5693->dev, "using non-continuous MIPI clock\n");
+
 out_free_bus_cfg:
 	v4l2_fwnode_endpoint_free(&bus_cfg);
 
-- 
